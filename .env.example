# Copy to .env and fill in.  .env is git-ignored -- never commit real tokens.
#
# Hugging Face token with access to the gated checkpoint facebook/sam3.1
# (request access at https://huggingface.co/facebook/sam3.1)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: where to cache Hugging Face weights on Colab (usually a Drive dir)
# HF_HOME=/content/drive/MyDrive/hp_cache
